# Sao chép thành .env rồi sửa nếu cần
DATABASE_URL=postgresql+psycopg://ticketnhip:ticketnhip@localhost:5432/ticketnhip
TEST_DATABASE_URL=postgresql+psycopg://ticketnhip:ticketnhip@localhost:5432/ticketnhip_test
# dev: in SQL ra log, cookie không Secure (http://localhost), /auth/forgot trả devResetUrl.
# KHÔNG dùng dev khi chạy thật — bỏ dòng này hoặc đặt ENV=prod.
ENV=dev
