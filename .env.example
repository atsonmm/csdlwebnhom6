# Cấu hình Docker Compose — sao chép thành .env (KHÔNG đưa .env lên Git) rồi đổi mật khẩu.

# ---- Máy ảo CSDL (dịch vụ db)
POSTGRES_DB=ticketnhip
POSTGRES_USER=ticketnhip
POSTGRES_PASSWORD=doi-mat-khau-nay
DB_PORT=5433                 # cổng mở ra ngoài của máy ảo CSDL

# ---- Máy ảo BACKEND (dịch vụ backend)
DB_HOST=db                   # 3 máy ảo: IP máy ảo CSDL (vd. 192.168.56.11)
DB_HOST_PORT=5432            # 3 máy ảo: cổng DB_PORT của máy CSDL (vd. 5433)
APP_ENV=prod                 # prod: không in SQL, không trả devResetUrl
COOKIE_SECURE=false          # true khi đã có HTTPS; false khi chạy http://IP (nếu không trình duyệt không gửi cookie)
ADMIN_EMAIL=admin@ticketnhip.vn
ADMIN_PASSWORD=doi-mat-khau-quan-tri
SEED_CATALOG=1               # 1: nạp danh mục sự kiện mẫu khi khởi động (upsert, chạy lại an toàn)
UVICORN_WORKERS=2
# Ảnh sự kiện do BTC upload: Docker dùng volume uploads-data (/data/uploads); chạy tay mặc định <repo>/.data/uploads
# UPLOAD_DIR=/data/uploads
BACKEND_PORT=8000

# ---- Máy ảo FRONTEND (dịch vụ frontend)
BACKEND_URL=http://backend:8000   # 3 máy ảo: http://<IP máy ảo backend>:8000
FRONTEND_PORT=8080
